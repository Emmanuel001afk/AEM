{
  "name": "aem-store",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.ts",
    "build:mobile": "tsc --noEmit && vite build --config vite.mobile.config.ts",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:preview": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "test:unit": "node --test tests/unit/runtime.test.mjs",
    "test:desktop": "playwright test",
    "test:android": "node scripts/verify-android.mjs",
    "verify:win": "npm run test:unit && npm run dist:win && npm run test:desktop"
  },
  "dependencies": {
    "@capacitor/core": "7.4.4",
    "@tanstack/react-query": "5.87.4",
    "electron-updater": "6.8.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  },
  "productName": "AEM Store",
  "description": "AEM software store with a local Android development and testing device",
  "author": "AEM",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  }
}
